NODE_ENV=production
PORT=4000

# In production, prefer MONGO_URI (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

JWT_SECRET=change_me_in_production_please_use_a_long_random_string
JWT_EXPIRES_IN=7d

# Set to your deployed frontend URL on Vercel
CLIENT_ORIGIN=https://<your-frontend>.vercel.app

APP_BRAND_NAME=TICOL

# Groq provider (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=700
GROQ_TEMPERATURE=0.2
GROQ_TIMEOUT_MS=12000

# Legacy AI vars kept for compatibility with older deployments
AI_PROVIDER=local
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=700
